{
  "name": "bunny-learn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Little learning games for kids: Bunny Math and Bunny English.",
  "scripts": {
    "dev": "pnpm --filter @bunny/math dev",
    "dev:math": "pnpm --filter @bunny/math dev",
    "dev:english": "pnpm --filter @bunny/english dev",
    "build": "pnpm -r build",
    "build:site": "node scripts/build-site.mjs",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @bunny/math e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0"
}
